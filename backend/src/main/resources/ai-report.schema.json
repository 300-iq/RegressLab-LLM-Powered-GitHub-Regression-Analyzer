                  "type": "string"
                },
                "line": {
                  "type": "integer"
                }
              }
            }
          },
          "comparisonId": {
            "type": "string"
          },
          "technicalExplanation": {
            "type": "string"
          },
          "verificationExperiment": {
            "type": "string"
          },
          "uncertainty": {
            "type": "string"
          }
        }
      }
    },
    "missingEvidence": {
      "type": "array",
      "items": {
        "type": "string"
      }
    }
  }
}
