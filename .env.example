# Local development credentials only. Compose binds PostgreSQL to loopback.
POSTGRES_DB=regresslab
POSTGRES_USER=regresslab
POSTGRES_PASSWORD=
POSTGRES_PORT=5432

# Generate POSTGRES_PASSWORD and REGRESSLAB_INGESTION_TOKEN locally. See docs/local-setup.md.
REGRESSLAB_INGESTION_TOKEN=

# Optional backend-only AI settings; export in the backend terminal, never Next.js.
# Generation still requires the protected local-ingestion profile and private token.
REGRESSLAB_AI_ENABLED=false
REGRESSLAB_OLLAMA_URL=http://127.0.0.1:11434
REGRESSLAB_OLLAMA_MODEL=qwen3:4b
REGRESSLAB_OLLAMA_TIMEOUT_SECONDS=120

REGRESSLAB_OLLAMA_CONTEXT_TOKENS=16384
