{
  "name": "regresslab",
  "version": "0.1.0",
  "private": true,
  "workspaces": [
    "frontend",
    "contracts"
  ],
  "engines": {
    "node": ">=22.0.0 <27",
    "npm": ">=10"
  },
  "scripts": {
    "dev": "npm run dev --workspace frontend",
    "build": "npm run build --workspace frontend",
    "lint": "npm run lint --workspace frontend",
    "typecheck": "npm run typecheck --workspace frontend",
    "test": "npm run test --workspace contracts && npm run test --workspace frontend",
    "test:e2e": "npm run test:e2e --workspace frontend",
    "check": "npm run lint && npm run typecheck && npm test && npm run build",
    "evaluate:ai": "python3 evaluation/run.py"
  }
}
